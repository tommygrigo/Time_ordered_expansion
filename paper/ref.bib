@article{mendoza-arenas_heat_2013,
	title = {Heat transport in the \textit{{X}} \textit{{X}} \textit{{Z}} spin chain: from ballistic to diffusive regimes and dephasing enhancement},
	volume = {2013},
	issn = {1742-5468},
	shorttitle = {Heat transport in the \textit{{X}} \textit{{X}} \textit{{Z}} spin chain},
	url = {https://iopscience.iop.org/article/10.1088/1742-5468/2013/07/P07007},
	doi = {10.1088/1742-5468/2013/07/P07007},
	abstract = {In this work we study the heat transport in an XXZ spin-1/2 Heisenberg chain with homogeneous magnetic ﬁeld, incoherently driven out of equilibrium by reservoirs at the boundaries. We focus on the eﬀect of bulk dephasing (energy-dissipative) processes in diﬀerent parameter regimes of the system. The non-equilibrium steady state of the chain is obtained by simulating its evolution under the corresponding Lindblad master equation, using the time evolving block decimation method. In the absence of dephasing, the heat transport is ballistic for weak interactions, while being diﬀusive in the strongly interacting regime, as evidenced by the heat current scaling with the system size. When bulk dephasing takes place in the system, diﬀusive transport is induced in the weakly interacting regime, with the heat current monotonically decreasing with the dephasing rate. In contrast, in the strongly interacting regime, the heat current can be signiﬁcantly enhanced by dephasing for systems of small size.},
	number = {07},
	urldate = {2023-09-08},
	journal = {Journal of Statistical Mechanics: Theory and Experiment},
	author = {Mendoza-Arenas, J J and Al-Assam, S and Clark, S R and Jaksch, D},
	month = jul,
	year = {2013},
	pages = {P07007},
	file = {Mendoza-Arenas et al_2013_Heat transport in the iX-i iX-i iZ-i spin chain.pdf:/home/tommy/Dropbox/My_digital_library/Quantum/Q models/Spin chains/XXZ model/Mendoza-Arenas et al_2013_Heat transport in the iX-i iX-i iZ-i spin chain.pdf:application/pdf},
}

